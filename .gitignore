# ---------------------------------------------------------------- 真实凭证
# 所有含手机号 / token / JWT / Bearer 的文件一律不入库
configs/
configs_fj/
config_fj.json
config.json
.cmcc_jwt_cache*.json
.cmcc_seed_state*.json
.cmcc_ticket_cache*.json

# 运行时状态与日志（含账号尾号、领奖记录）
gui_data/
logs/
*.log

# 抓包文件（含完整票据与手机号）
*.har

# ---------------------------------------------------------------- 构建产物
build/
dist/
__pycache__/
*.pyc
*.pyd

# 调试用的临时 spec（正式 spec 需要入库）
签到调试.spec

# 打包好的可执行文件（用 build_exe.bat 现场构建）
*.exe

# 本地工具状态
.workbuddy/
.vscode/
.idea/
.venv/
venv/

