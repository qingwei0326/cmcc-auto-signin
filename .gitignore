# ---------------------------------------------------------------- 真实凭证
# 所有含手机号 / token / JWT / Bearer 的文件一律不入库
configs/
configs_fj/
config_fj.json
config.json
.cmcc_jwt_cache*.json
.cmcc_seed_state*.json
.cmcc_ticket_cache*.json

# 运行时状态与日志（含账号尾号、领奖记录）
gui_data/
logs/
*.log

# 抓包文件（含完整票据与手机号）
*.har

# ---------------------------------------------------------------- 构建产物
build/
dist/
__pycache__/
*.pyc
*.pyd

# 调试用的临时 spec（正式 spec 需要入库）
签到调试.spec

# 打包好的可执行文件（用 build_exe.bat 现场构建）
*.exe

# 本地工具状态
.workbuddy/
.qwen/
.vscode/
.idea/
.venv/
venv/

# 系统文件
.DS_Store
Thumbs.db
desktop.ini

# 临时诊断脚本（一次性排查用，不入库）
# 例外：probe_token_life.py（票据寿命探测）与 probe_fj.py（控制台「只读探测」按钮
# 直接调用它）都是正式功能，必须入库，否则新克隆的机器上按钮一点就报错
probe_*.py
!probe_token_life.py
!probe_fj.py
